{
  "name": "recur-skills",
  "version": "0.0.7",
  "description": "Claude Code skills for Recur - Taiwan's subscription payment platform",
  "keywords": [
    "recur",
    "claude-code",
    "skills",
    "subscription",
    "payments",
    "taiwan",
    "agent-skills"
  ],
  "homepage": "https://recur.tw/skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/recur-tw/skills"
  },
  "license": "MIT",
  "author": {
    "name": "Recur",
    "email": "hi@recur.tw",
    "url": "https://recur.tw"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./skills/*": "./skills/*"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "recur-skills": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check:examples": "node scripts/typecheck-examples.mjs",
    "prepublishOnly": "pnpm build",
    "version": "node scripts/sync-version.js && git add .claude-plugin/marketplace.json skills/*/SKILL.md"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "express": "^5.2.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recur-tw": "^0.16.1",
    "tsdown": "^0.18.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
